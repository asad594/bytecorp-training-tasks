DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# This is Payload's OWN database — only for CMS admin-user accounts and media.
# It does NOT store jobs/companies/users/skills; those stay in the Django DB
# and are read/written live through the proxy below.

# Base URL of the deployed Django API (no trailing slash), e.g.
# https://bytecorp-training-tasks-production.up.railway.app
DJANGO_API_BASE_URL=http://localhost:8000

# A real admin account on the job board (created via createsuperuser / the
# manual superuser script) that the CMS logs in as to call the Django API.
DJANGO_ADMIN_EMAIL=admin.JobBoard@gmail.com
DJANGO_ADMIN_PASSWORD=CHANGE_ME